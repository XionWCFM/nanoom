{
  "$schema": "nanoom.schema.json",
  "workspace": {
    "include": [
      "tools/*"
    ]
  },
  "checkout": {
    "always": [
      ".github",
      ".yarn/releases",
      "crates",
      "docs",
      "examples",
      "packages",
      "scripts",
      "src",
      "tests"
    ]
  },
  "group": {
    "linux": {
      "tasks": [
        "check"
      ],
      "runnerLabels": [
        "ubuntu-latest"
      ],
      "rules": [
        {
          "name": "@nanoom/ci-macos",
          "ignore": true
        },
        {
          "name": "@nanoom/ci-windows",
          "ignore": true
        }
      ]
    },
    "macos": {
      "tasks": [
        "test"
      ],
      "runnerLabels": [
        "macos-latest"
      ],
      "rules": [
        {
          "name": "@nanoom/ci-linux",
          "ignore": true
        },
        {
          "name": "@nanoom/ci-windows",
          "ignore": true
        }
      ]
    },
    "windows": {
      "tasks": [
        "test"
      ],
      "runnerLabels": [
        "windows-latest"
      ],
      "rules": [
        {
          "name": "@nanoom/ci-linux",
          "ignore": true
        },
        {
          "name": "@nanoom/ci-macos",
          "ignore": true
        }
      ]
    }
  },
  "globalDependencies": [
    "**"
  ]
}

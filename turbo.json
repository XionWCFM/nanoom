{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "outputs": [
        ".next/types/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "cache": false
    },
    "test": {
      "cache": false
    }
  }
}

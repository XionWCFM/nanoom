name: Release

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:
    inputs:
      version:
        description: Existing release tag to build and publish
        required: true
        type: string

permissions:
  actions: read
  contents: write
  id-token: write

jobs:
  create-release:
    name: Create GitHub release
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.tag.outputs.version }}

    steps:
      - name: Checkout release source
        uses: actions/checkout@v7
        with:
          ref: ${{ inputs.version || github.ref }}

      - name: Extract version from tag
        id: tag
        run: echo "version=${{ inputs.version || github.ref_name }}" >> "$GITHUB_OUTPUT"

      - name: Validate tag and package versions
        run: bash scripts/version-consistency.sh '${{ inputs.version || github.ref_name }}'

      - name: Create release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ steps.tag.outputs.version }}
          generate_release_notes: true
          # Keep the release draft while parallel jobs upload assets. GitHub
          # makes published releases immutable, so publishing here would race
          # with the matrix uploads.
          draft: true

  build-binaries:
    name: Build ${{ matrix.target }}
    runs-on: ${{ matrix.os }}
    needs: create-release
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-latest
            target: x86_64-unknown-linux-gnu
            goos: linux
            goarch: amd64
            artifact: nanoom-linux-x64.tar.gz
          - os: ubuntu-latest
            target: aarch64-unknown-linux-gnu
            goos: linux
            goarch: arm64
            artifact: nanoom-linux-arm64.tar.gz
          - os: macos-latest
            target: x86_64-apple-darwin
            goos: darwin
            goarch: amd64
            artifact: nanoom-macos-x64.tar.gz
          - os: macos-latest
            target: aarch64-apple-darwin
            goos: darwin
            goarch: arm64
            artifact: nanoom-macos-arm64.tar.gz
          - os: windows-latest
            target: x86_64-pc-windows-msvc
            goos: windows
            goarch: amd64
            artifact: nanoom-windows-x64.zip

    steps:
      - name: Checkout release source
        uses: actions/checkout@v7
        with:
          ref: ${{ inputs.version || github.ref }}

      - name: Set up Go
        uses: actions/setup-go@v7
        with:
          go-version-file: go.mod

      - name: Build Go binary
        shell: bash
        env:
          GOOS: ${{ matrix.goos }}
          GOARCH: ${{ matrix.goarch }}
        run: |
          output=dist/nanoom
          if [[ "$GOOS" == windows ]]; then output=dist/nanoom.exe; fi
          bash scripts/build-go-cli.sh "$output"

      - name: Smoke test native Go binary
        shell: bash
        run: |
          native_os=$(go env GOOS)
          native_arch=$(go env GOARCH)
          if [[ "$native_os" == '${{ matrix.goos }}' && "$native_arch" == '${{ matrix.goarch }}' ]]; then
            binary=./dist/nanoom
            if [[ "$native_os" == windows ]]; then binary=./dist/nanoom.exe; fi
            expected=$(node -p 'require("./packages/cli/package.json").version')
            "$binary" --version | grep -Fqx "nanoom $expected"
            go test ./internal/cli/...
          fi

      - name: Package (unix tar.gz)
        if: runner.os != 'Windows'
        run: |
          cd dist
          tar czf "/tmp/${{ matrix.artifact }}" nanoom
          (cd /tmp && shasum -a 256 "${{ matrix.artifact }}" > "${{ matrix.artifact }}.sha256")
          cp /tmp/${{ matrix.artifact }}* "$GITHUB_WORKSPACE/"

      - name: Package (windows zip)
        if: runner.os == 'Windows'
        shell: pwsh
        run: |
          Compress-Archive -Path "dist/nanoom.exe" -DestinationPath "${{ matrix.artifact }}"
          $hash = (Get-FileHash "${{ matrix.artifact }}" -Algorithm SHA256).Hash.ToLower()
          "$hash  ${{ matrix.artifact }}" | Out-File "${{ matrix.artifact }}.sha256" -Encoding ascii

      - name: Install cosign
        uses: sigstore/cosign-installer@v4.1.2

      - name: Sign release archive
        shell: bash
        env:
          COSIGN_YES: "true"
        run: |
          cosign sign-blob "${{ matrix.artifact }}" \
            --bundle "${{ matrix.artifact }}.sigstore.json"

      - name: Upload artifact for release smoke test
        uses: actions/upload-artifact@v4.6.2
        with:
          name: release-${{ matrix.artifact }}
          path: |
            ${{ matrix.artifact }}
            ${{ matrix.artifact }}.sha256
            ${{ matrix.artifact }}.sigstore.json

  verify-release:
    name: Verify release artifacts
    runs-on: ubuntu-latest
    needs: publish-assets
    steps:
      - name: Checkout release source
        uses: actions/checkout@v7
        with:
          ref: ${{ inputs.version || github.ref }}
      - name: Download release artifacts
        shell: bash
        env:
          API: ${{ github.api_url }}
          REPOSITORY: ${{ github.repository }}
          TOKEN: ${{ github.token }}
          RUNNER_TEMP: ${{ runner.temp }}
        run: |
          source .github/actions/_setup/artifacts.sh
          artifacts=$(nanoom_run_artifacts "$GITHUB_RUN_ID")
          nanoom_download_artifacts "$artifacts" prefix release- release-artifacts
      - name: Install cosign
        uses: sigstore/cosign-installer@v4.1.2
      - name: Verify archives, checksums, permissions, and executable payload
        run: bash scripts/release-smoke.sh release-artifacts
      - name: Verify Yarn platform package contracts
        run: bash scripts/platform-package-smoke.sh
      - name: Verify Sigstore bundles
        env:
          COSIGN_EXPERIMENTAL: "1"
        run: |
          for bundle in release-artifacts/*.sigstore.json; do
            archive="${bundle%.sigstore.json}"
            cosign verify-blob "$archive" \
              --bundle "$bundle" \
              --certificate-oidc-issuer-regexp 'https://token.actions.githubusercontent.com' \
              --certificate-identity-regexp 'https://github.com/XionWCFM/nanoom/.github/workflows/release.yml@refs/(tags/v.*|heads/main)'
          done

  publish-assets:
    name: Upload release assets
    runs-on: ubuntu-latest
    needs: build-binaries
    steps:
      - name: Checkout release source
        uses: actions/checkout@v7
        with:
          ref: ${{ inputs.version || github.ref }}
      - name: Download release artifacts
        shell: bash
        env:
          API: ${{ github.api_url }}
          REPOSITORY: ${{ github.repository }}
          TOKEN: ${{ github.token }}
          RUNNER_TEMP: ${{ runner.temp }}
        run: |
          source .github/actions/_setup/artifacts.sh
          artifacts=$(nanoom_run_artifacts "$GITHUB_RUN_ID")
          nanoom_download_artifacts "$artifacts" prefix release- release-assets
      - name: Upload all assets to the draft release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          tag='${{ inputs.version || github.ref_name }}'
          for asset in release-assets/*; do
            name="${asset##*/}"
            if gh release view "$tag" --repo '${{ github.repository }}' --json assets --jq '.assets[].name' | grep -Fxq "$name"; then
              echo "Skipping existing release asset: $name"
            else
              gh release upload "$tag" "$asset" --repo '${{ github.repository }}'
            fi
          done

  publish-npm:
    name: Publish @nanoom/cli to npm
    runs-on: ubuntu-latest
    needs: publish-release

    steps:
      - name: Checkout release source
        uses: actions/checkout@v7
        with:
          ref: ${{ inputs.version || github.ref }}

      - name: Set up Node.js for npm publishing
        uses: actions/setup-node@v7
        with:
          node-version: '20'
          registry-url: 'https://registry.npmjs.org'

      - name: Publish platform packages and CLI wrapper
        working-directory: packages/cli
        env:
          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
          YARN_NPM_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
          YARN_NPM_REGISTRY_SERVER: https://registry.npmjs.org
        run: bash scripts/publish-all.sh

  publish-release:
    name: Publish GitHub release
    runs-on: ubuntu-latest
    needs: verify-release
    steps:
      - name: Checkout release source
        uses: actions/checkout@v7
        with:
          ref: ${{ inputs.version || github.ref }}
      - name: Publish verified draft release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release edit "${{ inputs.version || github.ref_name }}" --draft=false --repo "${{ github.repository }}"
          git tag -f latest
          git push origin refs/tags/latest --force

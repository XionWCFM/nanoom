{
  "name": "nanoom-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "check": "yarn format:check && go vet ./... && go test -race ./...",
    "prepare": "lefthook install",
    "format": "gofmt -w cmd internal schema.go && oxfmt --write .",
    "format:check": "bash scripts/go-format-check.sh && oxfmt --check ."
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "lefthook": "2.1.14",
    "oxfmt": "0.67.0",
    "turbo": "^2.11.10"
  },
  "packageManager": "yarn@4.11.0"
}

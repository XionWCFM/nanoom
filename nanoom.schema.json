{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AffectedConfig": {
      "additionalProperties": false,
      "properties": {
        "maxFetchDepth": {
          "default": 2048,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "CheckoutConfig": {
      "additionalProperties": false,
      "properties": {
        "always": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "DistributionConfig": {
      "additionalProperties": false,
      "properties": {
        "full": {
          "$ref": "#/definitions/DistributionTier"
        },
        "medium": {
          "$ref": "#/definitions/DistributionTier"
        },
        "small": {
          "$ref": "#/definitions/DistributionTier"
        }
      },
      "required": [
        "full",
        "medium",
        "small"
      ],
      "type": "object"
    },
    "DistributionTier": {
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxAffectedPercent": {
          "format": "double",
          "type": "number"
        },
        "runnerLabels": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "timingEnvironment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "concurrency",
        "maxAffectedPercent"
      ],
      "type": "object"
    },
    "GroupConfig": {
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "anyOf": [
            {
              "$ref": "#/definitions/DistributionConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/definitions/Rule"
          },
          "type": "array"
        },
        "runner_labels": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tasks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timing_environment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "tasks"
      ],
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "ignore": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "shard": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ShardRule"
          },
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ShardRule": {
      "additionalProperties": false,
      "properties": {
        "shard": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "task": {
          "type": "string"
        }
      },
      "required": [
        "shard",
        "task"
      ],
      "type": "object"
    },
    "WorkspaceConfig": {
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "description": "Configuration for nanoom monorepo task runner",
  "properties": {
    "$schema": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "affected": {
      "allOf": [
        {
          "$ref": "#/definitions/AffectedConfig"
        }
      ],
      "default": {
        "maxFetchDepth": 2048
      }
    },
    "checkout": {
      "allOf": [
        {
          "$ref": "#/definitions/CheckoutConfig"
        }
      ],
      "default": {
        "always": []
      }
    },
    "globalDependencies": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "group": {
      "additionalProperties": {
        "$ref": "#/definitions/GroupConfig"
      },
      "default": {},
      "type": "object"
    },
    "workspace": {
      "allOf": [
        {
          "$ref": "#/definitions/WorkspaceConfig"
        }
      ],
      "default": {
        "exclude": [],
        "include": [
          "packages/*",
          "apps/*"
        ]
      }
    }
  },
  "title": "nanoom Configuration",
  "type": "object"
}